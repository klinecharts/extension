{
  "name": "@klinecharts/extension",
  "version": "0.1.0",
  "description": "Indicator and overlay extension for KLineChart.",
  "keywords": [
    "candlestick",
    "klinecharts",
    "extension",
    "overlay",
    "indicator"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./indicators/*": {
      "types": "./dist/indicators/*.d.ts",
      "import": "./dist/indicators/*.js",
      "require": "./dist/indicators/*.cjs",
      "default": "./dist/indicators/*.js"
    },
    "./overlays/*": {
      "types": "./dist/overlays/*.d.ts",
      "import": "./dist/overlays/*.js",
      "require": "./dist/overlays/*.cjs",
      "default": "./dist/overlays/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "biome:check": "biome check .",
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun run scripts/build.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "bun run biome:check && bun run typecheck",
    "dev": "bun --hot examples/index.html",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "prepack": "bun run check && bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/klinecharts/extension#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klinecharts/extension.git"
  },
  "bugs": {
    "url": "https://github.com/klinecharts/extension/issues"
  },
  "author": "liihuu",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "peerDependencies": {
    "klinecharts": ">=10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.3.14",
    "klinecharts": "^10.0.0",
    "typescript": "^7.0.2"
  }
}
